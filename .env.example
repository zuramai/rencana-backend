NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgres://localhost:5432/rencana
# Comma-separated browser origins allowed to call the API with cookies
WEB_ORIGINS=http://localhost:3000
# Where the web app lives (Google sign-in redirects back here); defaults to the first WEB_ORIGINS entry
WEB_APP_URL=http://localhost:3000
# >= 32 chars, signs the OAuth state cookie. Generate with: openssl rand -base64 48
COOKIE_SECRET=
# true only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Optional Google sign-in (set both or neither)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8787/auth/google/callback
# S3-compatible storage (MinIO in development)
S3_ENDPOINT=http://127.0.0.1:9100
S3_REGION=us-east-1
S3_BUCKET=rencana
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
