{
  "name": "rencana-backend",
  "private": true,
  "type": "module",
  "imports": {
    "#shared/*": "./src/shared/*.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "s3:init": "node --env-file=.env scripts/ensure-bucket.ts"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.11"
  },
  "dependencies": {
    "@adonisjs/hash": "9.1.1",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@hono/node-server": "^2.1.9",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify/utils": "^3.1.7",
    "@node-rs/argon2": "^2.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "countries-and-timezones": "^3.11.0",
    "country-to-currency": "^3.0.2",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "hono": "^4.13.19",
    "jose": "^6.2.17",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.3.14",
    "postgres": "^4.1.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^24.19.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
